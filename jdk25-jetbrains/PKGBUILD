# Maintainer: Jose Chasey Pratama (josepratama080@gmail.com)
#
# JetBrains Runtime (JBR) 25 from the official jbr25 branch, built with
# Arch's system clang or gcc.
#
# Optional env vars (no file edits): JBR_TOOLCHAIN=clang|gcc (beats CC/CXX;
# the toolchain type is derived from the CC/CXX binary name, default clang),
# JBR_EXTRA_CFLAGS/CXXFLAGS/LDFLAGS (appended after makepkg.conf's),
# JBR_NO_LTO=1 (keep the link-time-opt JVM feature off),
# JBR_BOOT_JDK=/path/to/jdk (override boot JDK autodetection),
# JBR_JOBS=<n> (build parallelism, default nproc cap 12),
# JBR_CONFIGURE_EXTRA="..." (raw extra configure args, e.g. --without-vulkan).
#
#
# Prebuilt JCEF jmods (jcef, gluegen.rt, jogl.all) from the pinned
# jbrsdk_jcef bundle are injected.
#
# Split packages from the same JDK image:
#   jre25-jetbrains            runtime; owns lib/modules (with the small
#                              jcef/jogl.all/gluegen.rt classes) but not the
#                              ~340 MB of JCEF natives
#   jre25-jetbrains-jcef       JCEF natives (Chromium, JOGL, gluegen) into the
#                              same _jvmdir; install on top for webviews
#   jdk25-jetbrains-devel      headers + demo apps (no src.zip, like Arch's)
#   jdk25-jetbrains-jmods      jmods for jlink
#   jdk25-jetbrains-jmods-jcef jcef/jogl.all/gluegen.rt jmods
#   jdk25-jetbrains            meta package pulling everything above
# bin/ is kept whole, so javac works even without -devel.

pkgbase=jdk25-jetbrains
pkgname=(jre25-jetbrains jre25-jetbrains-jcef jdk25-jetbrains-devel jdk25-jetbrains-jmods jdk25-jetbrains-jmods-jcef jdk25-jetbrains)
pkgver=25.0.4.1+arch.gfb137072
pkgrel=1
pkgdesc='JetBrains Runtime 25 runtime with JCEF (OpenJDK 25 fork with DCEVM, Chromium embedding and improved font/desktop integration)'
arch=('x86_64')
url='https://github.com/JetBrains/JetBrainsRuntime'
license=('GPL-2.0-only WITH Classpath-exception-2.0')
DEPENDS_RUNTIME=(
  'java-runtime-common>=3'
  'java-environment-common=3'
  'ca-certificates-utils'
  'glibc'
  'gcc-libs'
  'libgcc'
  'libstdc++'
  'freetype2' 'libfreetype.so'
  'fontconfig'
  'harfbuzz' 'libharfbuzz.so'
  'lcms2' 'liblcms2.so'
  'libjpeg-turbo' 'libjpeg.so'
  'giflib' 'libgif.so'
  'libpng'
  'zlib'
  'wayland'
  'libxkbcommon'
  'libx11' 'libxext' 'libxrender' 'libxrandr' 'libxt' 'libxtst'
  # JCEF natives (libcef.so / JOGL)
  'libxcb' 'libxcomposite' 'libxdamage' 'libxfixes' 'libxi' 'libxcursor' 'libxxf86vm'
  'libdrm' 'mesa'
  'glib2' 'at-spi2-core' 'dbus' 'libcups' 'alsa-lib'
  'cairo' 'pango' 'expat' 'nss' 'systemd-libs'
  # Custom allocator
  'mimalloc'
)
OPTDEPENDS=(
  'jre25-jetbrains-jcef: built-in browser engine (JCEF) for webviews, markdown preview and login dialogs'
  'speech-dispatcher: accessible announcer (A11Y) support'
  'gtk3: GTK look and feel for desktop usage'
  'gvfs: open links e.g. hyperlinks'
  'vulkan-icd-loader: Vulkan rendering pipeline (runtime loader, loaded via dlopen)'
)
_pick_toolchain() {
  local cc="${CC:-${CXX:-}}"
  if [[ -n ${JBR_TOOLCHAIN:-} ]]; then
    printf '%s' "$JBR_TOOLCHAIN"
  elif [[ -n $cc && $cc == *clang* ]]; then
    printf 'clang'
  elif [[ -n $cc ]]; then
    printf 'gcc'
  else
    printf 'clang'
  fi
}
_toolchain=$(_pick_toolchain)

makedepends=(
  'java-environment=25'
  "$_toolchain"
  'binutils'
  'make'
  'zip' 'unzip'
  'wayland-protocols'
  'speech-dispatcher'
  'shaderc'
  'vulkan-headers'
  'mimalloc'
)

options=('!ccache' 'lto')

