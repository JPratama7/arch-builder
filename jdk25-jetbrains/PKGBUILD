# Maintainer: Jose Chasey Pratama (josepratama080@gmail.com)
#
# JetBrains Runtime (JBR) 25, built from the official jbr25 branch with
# Arch's system clang (/usr/bin/clang).
#
# Every flag and dependency below was verified against the actual checkout:
#   doc/building.md                 boot JDK, toolchain, library, hardware docs
#   make/conf/version-numbers.conf  JDK version + acceptable boot JDK versions
#   make/autoconf/toolchain.m4      clang toolchain selection, CC/CXX handling
#                                   (min clang 13.0 on JDK 25)
#   make/autoconf/jvm-features.m4   valid/default JVM features (static-build
#                                   no longer exists in JDK 25)
#   make/autoconf/libraries.m4      external libraries; JBR-specific on Linux:
#                                   wayland + xkbcommon + wayland-protocols
#                                   are REQUIRED, dbus headers are REQUIRED,
#                                   speechd/vulkan are optional
#   jb/project/tools/linux/scripts/mkimages_x64.sh + common.sh
#                                   JetBrains' own canonical configure flags
#
# Optional environment variables (no file edits needed):
#   makepkg.conf CFLAGS/CXXFLAGS/CPPFLAGS/LDFLAGS are forwarded into the
#       build via --with-extra-*flags (the OpenJDK build ignores them as
#       environment variables). -flto* is filtered out there and mapped to
#       the 'link-time-opt' JVM feature instead (raw -flto breaks the JDK
#       build, JDK-8340215); -fexceptions is dropped (breaks ZGC linking).
#   JBR_EXTRA_CFLAGS / JBR_EXTRA_CXXFLAGS / JBR_EXTRA_LDFLAGS
#       Additional flags appended after the makepkg.conf ones
#   JBR_NO_LTO=1               keep the 'link-time-opt' JVM feature off
#                              even when makepkg.conf enables LTO
#   JBR_BOOT_JDK=/path/to/jdk   override boot JDK autodetection
#   JBR_JOBS=<n>                override build parallelism (default: nproc,
#                               capped at 12; hotspot jobs peak ~1-1.5 GB each)
#   JBR_CONFIGURE_EXTRA="..."   raw extra configure arguments, e.g.
#                               --with-vulkan (requires vulkan-headers and a
#                               vulkan shader compiler)
#
# Versioning note: the jbr25 branch tip is kept current (rebased onto each
# OpenJDK CPU update); the newest jbr-release-25.* tag can trail the tip by
# a few commits. This package tracks the branch tip; pkgver() derives the
# version from make/conf/version-numbers.conf plus the git state. After an
# upstream rebase the r<N> counter can move non-monotonically.
#
# JCEF: included the same way JetBrains' own release pipeline does it —
#       JCEF is NOT built from this tree; prebuilt JCEF jmods (JCEF 150 /
#       Chromium 150.0.7871.129) are taken from the official jbrsdk_jcef
#       bundle pinned below and injected after `make images` (module-info
#       patch + java.desktop/java.base jmod repack + jlink), replicating
#       jb/project/tools/linux/scripts/mkimages_x64.sh. Only the modules
#       our build lacks (jcef, gluegen.rt, jogl.all) are taken from it.
#       Bump _jcef_rel when the jbr25 base version changes.

pkgname=jdk25-jetbrains
pkgver=25.0.4.1.r0.gb4d19986
pkgrel=1
pkgdesc='JetBrains Runtime 25 development kit with JCEF (OpenJDK 25 fork with DCEVM, Chromium embedding and improved font/desktop integration)'
arch=('x86_64')
url='https://github.com/JetBrains/JetBrainsRuntime'
license=('GPL-2.0-only WITH Classpath-exception-2.0')
depends=(
  'java-runtime-common>=3'
  'java-environment-common=3'
  'ca-certificates-utils'
  'glibc'
