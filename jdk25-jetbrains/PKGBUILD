# jbrsdk_jcef bundle matching the jbr25 base version.
_jcef_rel=25.0.4.1-linux-x64-b635.72
_jcef_dirname=jbrsdk_jcef-${_jcef_rel}
_jcef_sha256=641b2058353f828f89465cff74f6cbd49ab14aed6078fd841772e91e5f23775a

source=(
  "${_src_name}.tar.gz::https://github.com/JetBrains/JetBrainsRuntime/archive/${_commit}.tar.gz"
  "${_jcef_dirname}.tar.gz::https://cache-redirector.jetbrains.com/intellij-jbr/${_jcef_dirname}.tar.gz"
)
sha256sums=('b8901f3c738aab876340ba60b099ff3c59142a9d151c342f1eecff81463e9f06'
            "${_jcef_sha256}")

_jvmdir=/usr/lib/jvm/java-25-jetbrains

# Files the jcef/jogl.all/gluegen.rt jmods contribute (relative to lib/).
# Owned by jre25-jetbrains-jcef; the base jre package strips them from its
# own copy so the two split packages never share a file with pacman.
_jcef_files=(
  cef_server
  chrome-sandbox
  chrome_100_percent.pak
  chrome_200_percent.pak
