  libjogl_mobile.so
  libnativewindow_awt.so
  libnativewindow_drm.so
  libnativewindow_x11.so
  libnewt_drm.so
  libnewt_head.so
  libgluegen_rt.so
)
_conf_name=linux-x86_64-server-release

filter_flags() {
  local out="" f
  for f in $1; do
    case "$f" in
      -flto|-flto=*|-ffat-lto-objects|-fno-fat-lto-objects|-fuse-linker-plugin|-fexceptions) ;;
      *) out="${out:+${out} }${f}" ;;
    esac
  done
  printf '%s' "$out"
}

# Port of update_jsdk_mods from jb/project/tools/common/scripts/common.sh:
# re-create java.desktop.jmod with a module-info granting jcef/jogl.all
# access to sun.awt/java.awt.peer, and java.base.jmod with updated hashes.
#   $1 = built jdk image (javac/jmod tools), $2 = dir with JCEF jmods,
#   $3 = dir with the original jmods, $4 = dir receiving the updated jmods
update_jsdk_mods() {
  local jsdk=$1 jcef_mods=$2 orig_mods=$3 updated_mods=$4
  local tmp hash_modules
  tmp=$(mktemp -d)

  "$jsdk/bin/jmod" extract --dir "$tmp" "$orig_mods/java.desktop.jmod"
  "$jsdk/bin/javac" \
      --patch-module "java.desktop=$orig_mods/java.desktop.jmod" \
      --module-path "$jcef_mods" -d "$tmp/classes" \
      src/java.desktop/share/classes/module-info.java
  "$jsdk/bin/jmod" create \
      --class-path "$tmp/classes" --config "$tmp/conf" --header-files "$tmp/include" \
      --legal-notice "$tmp/legal" --libs "$tmp/lib" \
      "$tmp/java.desktop.jmod"
  mv "$tmp/java.desktop.jmod" "$updated_mods/java.desktop.jmod"
  rm -rf "$tmp"

  hash_modules=$("$jsdk/bin/jmod" describe "$orig_mods/java.base.jmod" \
      | grep hashes | awk '{print $2}' | tr '\n' '|' | sed 's/|$//')
  tmp=$(mktemp -d)
  "$jsdk/bin/jmod" extract --dir "$tmp" "$orig_mods/java.base.jmod"
  rm -f "$updated_mods/java.base.jmod"
  "$jsdk/bin/jmod" create \
      --module-path "$updated_mods" --hash-modules "$hash_modules" \
      --class-path "$tmp/classes" --cmds "$tmp/bin" --config "$tmp/conf" \
      --header-files "$tmp/include" --legal-notice "$tmp/legal" --libs "$tmp/lib" \
      "$tmp/java.base.jmod"
  mv "$tmp/java.base.jmod" "$updated_mods/java.base.jmod"
  rm -rf "$tmp"
}

# dotted version (feature.update[.patch]) from make/conf/version-numbers.conf
_jbr_version() {
  local f u p
  f=$(awk -F= '$1=="DEFAULT_VERSION_FEATURE"{print $2}' "$1/make/conf/version-numbers.conf" | tr -d '[:space:]')
  u=$(awk -F= '$1=="DEFAULT_VERSION_UPDATE"{print $2}' "$1/make/conf/version-numbers.conf" | tr -d '[:space:]')
  p=$(awk -F= '$1=="DEFAULT_VERSION_PATCH"{print $2}' "$1/make/conf/version-numbers.conf" | tr -d '[:space:]')
  if [ "$p" = 0 ]; then
    printf '%s.%s' "$f" "$u"
  else
    printf '%s.%s.%s' "$f" "$u" "$p"
  fi
}

pkgver() {
  printf '%s+arch.g%s' \
    "$(_jbr_version "${srcdir}/${_src_name}")" \
    "${_commit:0:8}"
}

build() {
  cd "${srcdir}/${_src_name}"

  # OpenJDK's build system controls its own parallelism; a -j in MAKEFLAGS
  # breaks it (same workaround as Arch's java25-openjdk PKGBUILD).
  local _makeflag_j=$(printf '%s' "${MAKEFLAGS-}" | sed -En 's/.*-j([0-9]+).*/\1/p')
  export MAKEFLAGS=${MAKEFLAGS/-j${_makeflag_j}/}

  local _conf_cflags="${CFLAGS:-}"
  local _conf_cxxflags="${CXXFLAGS:-}"
  _conf_cflags="${_conf_cflags//-O2/-O3}"
  _conf_cxxflags="${_conf_cxxflags//-O2/-O3}"

  local _extra_cflags="$(filter_flags "${_conf_cflags} ${CPPFLAGS:-}")"
  local _extra_cxxflags="$(filter_flags "${_conf_cxxflags} ${CPPFLAGS:-}")"
  local _extra_ldflags="$(filter_flags "${LDFLAGS:-}")"


  _extra_cflags="${_extra_cflags:+${_extra_cflags} }${JBR_EXTRA_CFLAGS:-}"
  _extra_cxxflags="${_extra_cxxflags:+${_extra_cxxflags} }${JBR_EXTRA_CXXFLAGS:-}"
  _extra_ldflags="${_extra_ldflags:+${_extra_ldflags} }${JBR_EXTRA_LDFLAGS:-}"
  _extra_ldflags="${_extra_ldflags:+${_extra_ldflags} }-Wl,--no-as-needed -lmimalloc"

  unset CFLAGS CXXFLAGS CPPFLAGS LDFLAGS

  local _version=$(_jbr_version .)
  local _sha=${_commit:0:8}

  # Default parallelism: one job per core, capped at 12 to keep peak RAM
  # (~1-1.5 GB per hotspot compile job) within reach of a 16 GB machine.
  local _jobs=${JBR_JOBS:-$(nproc)}
  if (( _jobs > 12 )); then
    _jobs=12
  fi

  # LTO is requested through OpenJDK's own 'link-time-opt' JVM feature
  # (supported for both clang and gcc, see make/hotspot/lib/JvmFeatures.gmk),
  # never through raw -flto in the flags (JDK-8340215). JBR_NO_LTO=1 forces
  # it off even when makepkg.conf enables LTO.
  local _jvm_features="zgc,shenandoahgc"
  if check_option "lto" "y" && [[ -z ${JBR_NO_LTO:-} ]]; then
    _jvm_features="zgc,shenandoahgc,link-time-opt"
  fi

  local _boot_jdk_flag=()
  if [[ -n ${JBR_BOOT_JDK:-} ]]; then
    _boot_jdk_flag=(--with-boot-jdk="${JBR_BOOT_JDK}")
  fi

  echo "JBR build: toolchain=${_toolchain}"

  bash configure \
    --with-toolchain-type="${_toolchain}" \
    --with-jobs="${_jobs}" \
    --with-version-pre= \
    --with-version-build="${pkgrel}" \
    --with-version-opt="arch.g${_sha}" \
    --with-vendor-name="JetBrains s.r.o." \
    --with-vendor-version-string="JBR-${_version}" \
    --with-jvm-features="${_jvm_features}" \
    --enable-cds=yes \
    --with-stdc++lib=dynamic \
    --with-zlib=system \
    --with-libjpeg=system \
    --with-giflib=system \
    --with-libpng=system \
    --with-lcms=system \
    --with-harfbuzz=system \
    --with-freetype=system \
    --with-speechd-include=/usr/include/speech-dispatcher \
    --with-native-debug-symbols=none \
    --disable-warnings-as-errors \
    --disable-ccache \
    --enable-linktime-gc \
    --with-jmod-compress="zip-9" \
    --with-extra-cflags="${_extra_cflags}" \
    --with-extra-cxxflags="${_extra_cxxflags}" \
    --with-extra-ldflags="${_extra_ldflags}" \
    "${_boot_jdk_flag[@]}" \
    --with-vulkan \
    ${JBR_CONFIGURE_EXTRA:-}

  make images

  # ---- JCEF injection ----
  local JSDK="build/${_conf_name}/images/jdk"
  local _mods_dir="build/${_conf_name}/images/jmods"
  local _jcef_mods_src="$srcdir/${_jcef_dirname}/jmods"
  local _jcef_modules="" _img _modules _name _jmodfile

  for _jmodfile in "${_jcef_mods_src}"/*.jmod; do
    _name=$(basename "$_jmodfile" .jmod)
    [ -f "${_mods_dir}/${_name}.jmod" ] && continue
    case "$_name" in
      jcef|gluegen.rt|jogl.all) ;;
      *)
        echo "ERROR: unexpected module '${_name}' in the JCEF bundle (jbr base version mismatch?)"
        return 1
        ;;
    esac
    cp "$_jmodfile" "${_mods_dir}/"
    _jcef_modules="${_jcef_modules:+${_jcef_modules},}${_name}"
  done
  echo "JBR build: JCEF modules: ${_jcef_modules}"

  patch -p0 < jb/project/tools/patches/add_jcef_module.patch
  update_jsdk_mods "$JSDK" "${_jcef_mods_src}" "$JSDK/jmods" "${_mods_dir}"

  _modules=$(grep '^MODULES=' "${JSDK}/release" | sed 's/^MODULES=//; s/"//g; s/ /,/g')
  _modules="${_modules},${_jcef_modules}"

  _img="build/${_conf_name}/images/jdk-jcef"
  rm -rf "$_img"
  "$JSDK/bin/jlink" \
    --module-path "${_mods_dir}" \
    --add-modules "${_modules}" \
    --compress=2 \
    --generate-cds-archive \
    --output "$_img"

  grep -v '^JAVA_VERSION' "${JSDK}/release" | grep -v '^MODULES' >> "${_img}/release"
  cp -a "${JSDK}/demo" "${_img}/"
  cp "${JSDK}/lib/src.zip" "${_img}/lib/"
  mkdir -p "${_img}/jmods"
  cp "${_mods_dir}"/*.jmod "${_img}/jmods/"
  # jmod does not preserve file permissions (JDK-8173610)
  if [ -f "${_img}/lib/jcef_helper" ]; then chmod a+x "${_img}/lib/jcef_helper"; fi
  if [ -f "${_img}/lib/cef_server" ]; then chmod a+x "${_img}/lib/cef_server"; fi
}

check() {
  cd "${srcdir}/${_src_name}"
  local _img="build/${_conf_name}/images/jdk-jcef"
  "${_img}/bin/java" -version
  "${_img}/bin/java" --list-modules | grep -E '^(jcef|gluegen\.rt|jogl\.all)(@[0-9][^ ]*)?$'

  # --- validate mimalloc wiring ---
  local _needs=($(readelf -d "${_img}/lib/server/libjvm.so" | awk -F'[][]' '/NEEDED/{print $2}'))
  local _i _mi=-1 _libc=-1
  for _i in "${!_needs[@]}"; do
    case "${_needs[$_i]}" in
      libmimalloc.so.3*) _mi=$_i ;;
      libc.so.6) _libc=$_i ;;
    esac
  done
  if (( _mi < 0 || _libc < 0 || _mi > _libc )); then
    echo "ERROR: mimalloc not ordered before libc in libjvm.so DT_NEEDED (got: ${_needs[*]})"
    return 1
  fi
  echo "mimalloc check: DT_NEEDED order OK (${_needs[*]})"
  # check mimalloc stats
  if ! MIMALLOC_SHOW_STATS=1 "${_img}/bin/java" -Xmx64m -version 2>&1 | grep -q '^subproc'; then
    echo "ERROR: java did not resolve malloc to mimalloc"
    return 1
  fi
  echo "mimalloc check: malloc resolves through mimalloc OK"
}

package_jre25-jetbrains() {
  pkgdesc='JetBrains Runtime 25 runtime (OpenJDK 25 fork with DCEVM and improved font/desktop integration; browser engine shipped separately in jre25-jetbrains-jcef)'
  depends=("${DEPENDS_RUNTIME[@]}")
  optdepends=("${OPTDEPENDS[@]}")
  provides=(
    'java-runtime=25'
    'java-runtime-openjdk=25'
    'java-runtime-headless=25'
    'java-runtime-headless-openjdk=25'
  )
  backup=(
    etc/jre25-jetbrains/logging.properties
    etc/jre25-jetbrains/management/jmxremote.access
    etc/jre25-jetbrains/management/jmxremote.password.template
    etc/jre25-jetbrains/management/management.properties
    etc/jre25-jetbrains/net.properties
    etc/jre25-jetbrains/security/java.policy
    etc/jre25-jetbrains/security/java.security
    etc/jre25-jetbrains/security/policy/README.txt
    etc/jre25-jetbrains/security/policy/limited/default_US_export.policy
    etc/jre25-jetbrains/security/policy/limited/default_local.policy
    etc/jre25-jetbrains/security/policy/limited/exempt_local.policy
    etc/jre25-jetbrains/security/policy/unlimited/default_US_export.policy
    etc/jre25-jetbrains/security/policy/unlimited/default_local.policy
    etc/jre25-jetbrains/sound.properties
  )
  install=jre25-jetbrains.install

  cd "${srcdir}/${_src_name}/build/${_conf_name}/images/jdk-jcef"

  install -dm 755 "${pkgdir}${_jvmdir}"
  cp -a bin lib release "${pkgdir}${_jvmdir}"

  # JCEF natives belong to jre25-jetbrains-jcef; strip them from here so the
  # split packages never share a file. lib/modules keeps the (tiny) jcef
  # module classes, so only natives need re-adding.
  rm -rf "${pkgdir}${_jvmdir}/lib/locales"
  for _f in "${_jcef_files[@]}"; do
    rm -f "${pkgdir}${_jvmdir}/lib/${_f}"
  done

  rm -f "${pkgdir}${_jvmdir}/lib/src.zip"

  # Configuration -> /etc, pacman-managed through backup=()
  install -dm 755 "${pkgdir}/etc"
  cp -r conf "${pkgdir}/etc/${pkgname}"
  ln -s "/etc/${pkgname}" "${pkgdir}${_jvmdir}/conf"

  # Legal notices
  install -dm 755 "${pkgdir}/usr/share/licenses/${pkgname}"
  cp -r legal "${pkgdir}/usr/share/licenses/${pkgname}"
  ln -s "/usr/share/licenses/${pkgname}" "${pkgdir}${_jvmdir}/legal"

  # Man pages, suffixed per ArchWiki (Java) packager notes
  local f _man
  for f in bin/*; do
    f=$(basename "${f}")
    _man=man/man1/"${f}.1"
    if test -f "${_man}"; then
      install -Dm 644 "${_man}" "${pkgdir}/usr/share/man/man1/${f}-jre25-jetbrains.1"
    fi
  done
  ln -s /usr/share/man "${pkgdir}${_jvmdir}/man"

  # Use the system CA keystore (Arch convention)
  rm -f "${pkgdir}${_jvmdir}/lib/security/cacerts"
  ln -sf /etc/ssl/certs/java/cacerts "${pkgdir}${_jvmdir}/lib/security/cacerts"
}

package_jre25-jetbrains-jcef() {
  pkgdesc='JetBrains Runtime 25 native browser support (JCEF/Chromium, JOGL, gluegen)'
  depends=("jre25-jetbrains=${pkgver}")

  cd "${srcdir}/${_src_name}/build/${_conf_name}/images/jdk-jcef/lib"

  install -dm 755 "${pkgdir}${_jvmdir}/lib"
  for _f in "${_jcef_files[@]}"; do
    if [[ ${_f} == chrome-sandbox ]]; then
      # jmod extraction loses the setuid bit; restore it like upstream's image
      install -Dm 4755 chrome-sandbox "${pkgdir}${_jvmdir}/lib/chrome-sandbox"
    else
      cp -a "${_f}" "${pkgdir}${_jvmdir}/lib/${_f}"
    fi
  done
  cp -a locales "${pkgdir}${_jvmdir}/lib/locales"
}

package_jdk25-jetbrains-devel() {
  pkgdesc='JetBrains Runtime 25 developer files (headers and demo apps)'
  depends=("jre25-jetbrains=${pkgver}")

  cd "${srcdir}/${_src_name}/build/${_conf_name}/images/jdk-jcef"

  install -dm 755 "${pkgdir}${_jvmdir}"
  cp -a include demo "${pkgdir}${_jvmdir}"
}

package_jdk25-jetbrains-jmods() {
  pkgdesc='JetBrains Runtime 25 java module jmods for building custom runtimes with jlink'
  depends=("jre25-jetbrains=${pkgver}")

  cd "${srcdir}/${_src_name}/build/${_conf_name}/images/jdk-jcef"

  install -dm 755 "${pkgdir}${_jvmdir}"
  for _jmodfile in jmods/*.jmod; do
    _name=$(basename "$_jmodfile" .jmod)
    case "$_name" in
      jcef|gluegen.rt|jogl.all) continue ;;

    esac
    install -Dm 644 "$_jmodfile" "${pkgdir}${_jvmdir}/jmods/$(basename "$_jmodfile")"
  done
}

package_jdk25-jetbrains-jmods-jcef() {
  pkgdesc='JetBrains Runtime 25 JCEF module jmods (jcef, jogl.all, gluegen.rt) for jlink'
  depends=("jre25-jetbrains=${pkgver}")

  cd "${srcdir}/${_src_name}/build/${_conf_name}/images/jdk-jcef"

  install -dm 755 "${pkgdir}${_jvmdir}/jmods"
  for _name in jcef gluegen.rt jogl.all; do
    install -Dm 644 "jmods/${_name}.jmod" "${pkgdir}${_jvmdir}/jmods/${_name}.jmod"
  done
}

package_jdk25-jetbrains() {
  pkgdesc='Meta package for the full JetBrains Runtime 25 development kit with JCEF (runtime + browser engine + developer files + jmods)'
  depends=(
    "jre25-jetbrains=${pkgver}"
    "jre25-jetbrains-jcef=${pkgver}"
    "jdk25-jetbrains-devel=${pkgver}"
    "jdk25-jetbrains-jmods=${pkgver}"
    "jdk25-jetbrains-jmods-jcef=${pkgver}"
  )
  provides=(
    'java-environment=25'
    'java-environment-openjdk=25'
  )
}

# vim: ts=2 sw=2 et:
